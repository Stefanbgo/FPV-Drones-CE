<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef Name="FPV_EquipmentBase" ParentName="ResourceBase" Abstract="True">
    <stackLimit>1</stackLimit>
    <thingCategories><li>Manufactured</li></thingCategories>
    <statBases>
      <MaxHitPoints>45</MaxHitPoints>
      <Flammability>0.5</Flammability>
      <Beauty>0</Beauty>
    </statBases>
  </ThingDef>

  <ThingDef Name="FPV_DroneItemBase" ParentName="FPV_EquipmentBase" Abstract="True">
    <comps><li Class="FPVDrones.CompProperties_DroneBattery" /></comps>
  </ThingDef>

  <ThingDef ParentName="FPV_DroneItemBase">
    <defName>FPV_Kamikaze</defName>
    <label>FPV kamikaze</label>
    <description>Single-use radio FPV with the Combat Extended fragmentation effect. Equip an FPV controller in the primary slot to launch. A full battery lasts 30 seconds and the control radius is 100 cells. The drone detonates when its flight ends. A hostile jammer ends the flight early.</description>
    <graphicData>
      <texPath>FPVDrones/Kamikaze</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(0.86,0.86)</drawSize>
    </graphicData>
    <statBases><Mass>3.2</Mass><Bulk>4</Bulk><MarketValue>145</MarketValue></statBases>
  </ThingDef>

  <ThingDef ParentName="FPV_DroneItemBase">
    <defName>FPV_Scout</defName>
    <label>Mavik scout drone</label>
    <description>Reusable radio scout. Equip an FPV controller in the primary slot to launch. A full battery lasts 80 seconds and the control radius is 120 cells. Choose return or land to recover and recharge it at an FPV charging station. A hostile jammer forces a recoverable landing.</description>
    <graphicData>
      <texPath>FPVDrones/Scout</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(0.86,0.86)</drawSize>
    </graphicData>
    <statBases><Mass>1.8</Mass><Bulk>2.5</Bulk><MarketValue>165</MarketValue></statBases>
  </ThingDef>

  <ThingDef ParentName="FPV_EquipmentBase">
    <defName>FPV_Goggles</defName>
    <comps><li Class="FPVDrones.CompProperties_KitBinding" /></comps>
    <label>FPV goggles</label>
    <description>An obsolete flight accessory retained from older kits. Modern controllers have a built-in display.</description>
    <graphicData>
      <texPath>FPVDrones/Goggles</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(0.55,0.55)</drawSize>
    </graphicData>
    <statBases><Mass>0.25</Mass><MarketValue>40</MarketValue></statBases>
  </ThingDef>

  <ThingDef ParentName="FPV_EquipmentBase">
    <defName>FPV_Controller</defName>
    <equipmentType>Primary</equipmentType>
    <tools>
      <li Class="CombatExtended.ToolCE">
        <label>casing</label>
        <capacities><li>Blunt</li></capacities>
        <power>2</power>
        <cooldownTime>1.5</cooldownTime>
        <armorPenetrationBlunt>1</armorPenetrationBlunt>
      </li>
    </tools>
    <comps>
      <li><compClass>CompEquippable</compClass></li>
      <li Class="FPVDrones.CompProperties_KitBinding" />
    </comps>
    <label>FPV controller</label>
    <description>Equip this reusable controller in the primary slot and carry a charged drone in inventory. The controller can handle one active flight at a time.</description>
    <graphicData>
      <texPath>FPVDrones/Controller</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(0.55,0.55)</drawSize>
    </graphicData>
    <statBases><Mass>0.45</Mass><MarketValue>75</MarketValue></statBases>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>FPV_Charger</defName>
    <label>FPV charging station</label>
    <description>Connect the station to a power grid and place one Mavik on the pad. Charging uses 100 W and takes 60 seconds from empty at normal speed. The drone keeps its charge when removed or during a power outage.</description>
    <thingClass>FPVDrones.Building_DroneCharger</thingClass>
    <graphicData>
      <texPath>FPVDrones/Charger</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1.3,1.3)</drawSize>
    </graphicData>
    <tickerType>Normal</tickerType>
    <rotatable>false</rotatable>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.25</fillPercent>
    <size>(1,1)</size>
    <designationCategory>Misc</designationCategory>
    <surfaceType>Item</surfaceType>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <WorkToBuild>1700</WorkToBuild>
      <Flammability>0.4</Flammability>
    </statBases>
    <costList><Steel>40</Steel><ComponentIndustrial>2</ComponentIndustrial></costList>
    <researchPrerequisites><li>FPV_Drones</li></researchPrerequisites>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>100</basePowerConsumption>
        <idlePowerDraw>0</idlePowerDraw>
      </li>
    </comps>
    <building>
      <maxItemsInCell>1</maxItemsInCell>
      <fixedStorageSettings><filter><thingDefs><li>FPV_Scout</li></thingDefs></filter></fixedStorageSettings>
      <defaultStorageSettings>
        <priority>Important</priority>
        <filter><thingDefs><li>FPV_Scout</li></thingDefs></filter>
      </defaultStorageSettings>
    </building>
  </ThingDef>
</Defs>
