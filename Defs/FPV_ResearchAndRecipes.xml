<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ResearchProjectDef>
    <defName>FPV_Drones</defName>
    <label>FPV drones</label>
    <description>Build and operate remotely piloted drones, their control equipment, and a scout charging station.</description>
    <baseCost>1000</baseCost>
    <techLevel>Industrial</techLevel>
    <prerequisites><li>MicroelectronicsBasics</li></prerequisites>
    <requiredResearchBuilding>HiTechResearchBench</requiredResearchBuilding>
    <researchViewX>11.50</researchViewX>
    <researchViewY>3.95</researchViewY>
  </ResearchProjectDef>

  <RecipeDef Name="FPV_RecipeBase" Abstract="True">
    <recipeUsers><li>TableMachining</li></recipeUsers>
    <researchPrerequisite>FPV_Drones</researchPrerequisite>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <workSkill>Crafting</workSkill>
    <soundWorking>Recipe_Machining</soundWorking>
  </RecipeDef>

  <RecipeDef ParentName="FPV_RecipeBase">
    <defName>FPV_MakeKamikazeAmmo</defName>
    <label>make FPV kamikaze</label>
    <description>Assemble an FPV kamikaze using a Combat Extended fragmentation RPG-7 round.</description>
    <jobString>Assembling an FPV kamikaze.</jobString>
    <workerClass>FPVDrones.RecipeWorker_DroneAmmoMode</workerClass>
    <workAmount>4200</workAmount>
    <ingredients>
      <li><filter><thingDefs><li>Steel</li></thingDefs></filter><count>50</count></li>
      <li><filter><thingDefs><li>ComponentIndustrial</li></thingDefs></filter><count>3</count></li>
      <li><filter><thingDefs><li>Ammo_RPG7Grenade_Frag</li></thingDefs></filter><count>1</count></li>
    </ingredients>
    <fixedIngredientFilter><thingDefs><li>Steel</li><li>ComponentIndustrial</li><li>Ammo_RPG7Grenade_Frag</li></thingDefs></fixedIngredientFilter>
    <products><FPV_Kamikaze>1</FPV_Kamikaze></products>
  </RecipeDef>

  <RecipeDef ParentName="FPV_RecipeBase">
    <defName>FPV_MakeKamikazeNoAmmo</defName>
    <label>make FPV kamikaze</label>
    <description>Assemble an FPV kamikaze while the Combat Extended ammunition system is disabled.</description>
    <jobString>Assembling an FPV kamikaze.</jobString>
    <workerClass>FPVDrones.RecipeWorker_DroneAmmoMode</workerClass>
    <workAmount>4200</workAmount>
    <ingredients>
      <li><filter><thingDefs><li>Steel</li></thingDefs></filter><count>55</count></li>
      <li><filter><thingDefs><li>ComponentIndustrial</li></thingDefs></filter><count>4</count></li>
      <li><filter><thingDefs><li>Chemfuel</li></thingDefs></filter><count>5</count></li>
    </ingredients>
    <fixedIngredientFilter><thingDefs><li>Steel</li><li>ComponentIndustrial</li><li>Chemfuel</li></thingDefs></fixedIngredientFilter>
    <products><FPV_Kamikaze>1</FPV_Kamikaze></products>
  </RecipeDef>

  <RecipeDef ParentName="FPV_RecipeBase">
    <defName>FPV_MakeScout</defName>
    <label>make Mavik scout drone</label>
    <description>Assemble a reusable Mavik scout drone.</description>
    <jobString>Assembling a Mavik scout drone.</jobString>
    <workAmount>4800</workAmount>
    <ingredients>
      <li><filter><thingDefs><li>Steel</li></thingDefs></filter><count>40</count></li>
      <li><filter><thingDefs><li>ComponentIndustrial</li></thingDefs></filter><count>4</count></li>
    </ingredients>
    <fixedIngredientFilter><thingDefs><li>Steel</li><li>ComponentIndustrial</li></thingDefs></fixedIngredientFilter>
    <products><FPV_Scout>1</FPV_Scout></products>
  </RecipeDef>

  <RecipeDef ParentName="FPV_RecipeBase">
    <defName>FPV_MakeController</defName>
    <label>make FPV controller</label>
    <description>Assemble a reusable handheld FPV controller.</description>
    <jobString>Assembling an FPV controller.</jobString>
    <workAmount>2300</workAmount>
    <ingredients>
      <li><filter><thingDefs><li>Steel</li></thingDefs></filter><count>20</count></li>
      <li><filter><thingDefs><li>ComponentIndustrial</li></thingDefs></filter><count>2</count></li>
    </ingredients>
    <fixedIngredientFilter><thingDefs><li>Steel</li><li>ComponentIndustrial</li></thingDefs></fixedIngredientFilter>
    <products><FPV_Controller>1</FPV_Controller></products>
  </RecipeDef>
</Defs>
