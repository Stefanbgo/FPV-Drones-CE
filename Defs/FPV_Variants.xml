  <PawnKindDef ParentName="FPV_StrikeVariantKind">
    <defName>FPV_IncendiaryFiberAir</defName>
    <label>fiber-optic incendiary FPV</label>
    <race>FPV_IncendiaryFiberAir</race>
    <lifeStages><li><bodyGraphicData><texPath>FPVDrones/KamikazeAir</texPath><drawSize>(0.9,0.9)</drawSize><color>(227,128,241)</color></bodyGraphicData></li></lifeStages>
